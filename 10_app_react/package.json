{
  "name": "fraudlens-react",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "FRAUD_AUTH_MODE=none NODE_ENV=development node --env-file-if-exists=.env server.mjs",
    "dev:gcp": "FRAUD_AUTH_MODE=gcp NODE_ENV=development node --env-file-if-exists=.env server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "FRAUD_AUTH_MODE=none NODE_ENV=production node --env-file-if-exists=.env server.mjs",
    "start:gcp": "FRAUD_AUTH_MODE=gcp NODE_ENV=production node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/server.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^1.74.0",
    "plotly.js-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
